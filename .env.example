# Copy to .env.local and fill in. .env.local is gitignored -- never commit it.
#
# The UI renders with none of these set: the session-refresh guard in
# src/lib/supabase/middleware.ts skips itself when the two NEXT_PUBLIC_SUPABASE
# values are absent. The pipeline routes need all of them.

# --- Supabase (Settings -> API in your project dashboard) -------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / public key. Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key. SECRET -- server-only, bypasses Row Level Security.
# Never prefix it with NEXT_PUBLIC_, never reference it in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub ----------------------------------------------------------------

# A classic personal access token with NO scopes is enough for public repos.
# Strongly recommended: unauthenticated GitHub API requests are rate-limited
# per IP, and on Vercel that IP is shared with every other deployment on the
# instance. Discovering that limit during judging is a bad way to discover it.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Models ----------------------------------------------------------------

# Question generation. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-haiku-4-5, which is what the tech
# design budgets for and what the 50-repository run was verified against.
# A larger model costs roughly twenty times as much per quiz for no measured
# gain in citation-verification pass rate.
ANTHROPIC_MODEL=

# Embeddings for retrieval. Anthropic does not serve an embeddings endpoint,
# so this is a separate provider. The default model is text-embedding-3-small,
# whose 1536 dimensions match the vector(1536) column in the schema -- changing
# provider or model means changing that column too.
# https://platform.openai.com/api-keys
EMBEDDING_API_KEY=

# Optional overrides. Defaults: https://api.openai.com/v1 and
# text-embedding-3-small.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
